#!/usr/bin/env bash
# IRO router-wrapper — kulon fiok, kulon kulcs, mint az olvasoe.
# A szetvalasztas szandekos: a napi lekerdezes ne irhasson.
set -euo pipefail
ROUTER_HOST="${ROUTER_HOST:-192.0.2.1}"
ROUTER_USER="${ROUTER_ADMIN_USER:-wg-rw}"
ROUTER_KEY="${ROUTER_ADMIN_KEY:-$HOME/.ssh/id_router_rw}"
exec ssh -i "$ROUTER_KEY" -o StrictHostKeyChecking=yes \
     -o ConnectTimeout=10 "${ROUTER_USER}@${ROUTER_HOST}" "$1"
